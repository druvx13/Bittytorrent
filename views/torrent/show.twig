{% extends "layout/base.twig" %}

{% block content %}
<div class="row">
    <div class="col-md-8">
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="bi bi-file-earmark"></i> {{ torrent.title }}
                </h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6>Category:</h6>
                        {% if torrent.category_name %}
                        <span class="badge bg-secondary">{{ torrent.category_name }}</span>
                        {% else %}
                        <span class="text-muted">Uncategorized</span>
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        <h6>Uploader:</h6>
                        <span>{{ torrent.username|default('Anonymous') }}</span>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6>Size:</h6>
                        {% if torrent.size_bytes > 0 %}
                            {% if torrent.size_bytes > 1073741824 %}
                                {{ (torrent.size_bytes / 1073741824)|number_format(2) }} GB
                            {% elseif torrent.size_bytes > 1048576 %}
                                {{ (torrent.size_bytes / 1048576)|number_format(2) }} MB
                            {% else %}
                                {{ (torrent.size_bytes / 1024)|number_format(2) }} KB
                            {% endif %}
                        {% else %}
                            <span class="text-muted">Unknown</span>
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        <h6>Uploaded:</h6>
                        <span>{{ torrent.created_at|date('Y-m-d H:i') }}</span>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-12">
                        <h6>Info Hash:</h6>
                        <code>{{ torrent.info_hash }}</code>
                    </div>
                </div>
                
                {% if torrent.description %}
                <div class="row mb-3">
                    <div class="col-md-12">
                        <h6>Description:</h6>
                        <p>{{ torrent.description|nl2br }}</p>
                    </div>
                </div>
                {% endif %}
                
                <div class="d-grid gap-2">
                    <a href="/download/{{ torrent.id }}" class="btn btn-success btn-lg">
                        <i class="bi bi-download"></i> Download Torrent
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card shadow mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Statistics</h5>
            </div>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-arrow-up text-success"></i> Seeders</span>
                    <span class="badge bg-success">{{ peer_stats.seeders|default(0) }}</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-arrow-down text-warning"></i> Leechers</span>
                    <span class="badge bg-warning">{{ peer_stats.leechers|default(0) }}</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-check-circle text-info"></i> Completed</span>
                    <span class="badge bg-info">{{ torrent.completed|default(0) }}</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-eye"></i> Views</span>
                    <span class="badge bg-secondary">{{ torrent.views|default(0) }}</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
