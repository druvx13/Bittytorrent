{% extends "layout/base.twig" %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <h1><i class="bi bi-file-earmark"></i> Manage Torrents</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                <li class="breadcrumb-item active">Torrents</li>
            </ol>
        </nav>
        <hr>
    </div>
</div>

{% if session.success %}
<div class="alert alert-success alert-dismissible fade show">
    {{ session.success }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{% endif %}

{% if session.error %}
<div class="alert alert-danger alert-dismissible fade show">
    {{ session.error }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{% endif %}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Torrents ({{ total_torrents }})</h5>
    </div>
    <div class="card-body">
        {% if torrents %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Size</th>
                        <th>Seeders</th>
                        <th>Leechers</th>
                        <th>Completed</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for torrent in torrents %}
                    <tr>
                        <td>{{ torrent.id }}</td>
                        <td>
                            <a href="/torrent/{{ torrent.id }}">{{ torrent.title }}</a>
                        </td>
                        <td>{{ (torrent.size_bytes / 1024 / 1024)|number_format(2) }} MB</td>
                        <td><span class="badge bg-success">{{ torrent.seeders }}</span></td>
                        <td><span class="badge bg-warning">{{ torrent.leechers }}</span></td>
                        <td>{{ torrent.completed }}</td>
                        <td>{{ torrent.created_at|date('Y-m-d H:i') }}</td>
                        <td>
                            <form method="post" action="/admin/torrents/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this torrent?');">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <input type="hidden" name="torrent_id" value="{{ torrent.id }}">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        {% if total_pages > 1 %}
        <nav>
            <ul class="pagination">
                {% for page in 1..total_pages %}
                <li class="page-item {% if page == current_page %}active{% endif %}">
                    <a class="page-link" href="/admin/torrents?page={{ page }}">{{ page }}</a>
                </li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
        {% else %}
        <p class="text-muted">No torrents found.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
