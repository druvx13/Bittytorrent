{% extends "layout/base.twig" %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <h1><i class="bi bi-people"></i> Manage Users</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                <li class="breadcrumb-item active">Users</li>
            </ol>
        </nav>
        <hr>
    </div>
</div>

{% if session.success %}
<div class="alert alert-success alert-dismissible fade show">
    {{ session.success }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{% endif %}

{% if session.error %}
<div class="alert alert-danger alert-dismissible fade show">
    {{ session.error }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{% endif %}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Users ({{ total_users }})</h5>
    </div>
    <div class="card-body">
        {% if users %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Uploaded</th>
                        <th>Downloaded</th>
                        <th>Registered</th>
                        <th>Last Login</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.username }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% if user.role == 'admin' %}
                                <span class="badge bg-danger">Admin</span>
                            {% else %}
                                <span class="badge bg-secondary">User</span>
                            {% endif %}
                        </td>
                        <td>{{ (user.upload_bytes / 1024 / 1024)|number_format(2) }} MB</td>
                        <td>{{ (user.download_bytes / 1024 / 1024)|number_format(2) }} MB</td>
                        <td>{{ user.created_at|date('Y-m-d H:i') }}</td>
                        <td>
                            {% if user.last_login %}
                                {{ user.last_login|date('Y-m-d H:i') }}
                            {% else %}
                                <span class="text-muted">Never</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.is_active %}
                                <span class="badge bg-success">Active</span>
                            {% else %}
                                <span class="badge bg-danger">Inactive</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.id != session.user_id %}
                            <form method="post" action="/admin/users/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                            {% else %}
                            <span class="text-muted">You</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        {% if total_pages > 1 %}
        <nav>
            <ul class="pagination">
                {% for page in 1..total_pages %}
                <li class="page-item {% if page == current_page %}active{% endif %}">
                    <a class="page-link" href="/admin/users?page={{ page }}">{{ page }}</a>
                </li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
        {% else %}
        <p class="text-muted">No users found.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
