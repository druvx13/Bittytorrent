{% extends 'layout/base.twig' %}

{% block title %}{{ user.username }} - User Profile{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle display-1"></i>
                    <h3 class="mt-3">{{ user.username }}</h3>
                    <p class="text-muted">
                        {% if user.role == 'admin' %}
                            <span class="badge bg-danger">Admin</span>
                        {% else %}
                            <span class="badge bg-primary">User</span>
                        {% endif %}
                    </p>
                    <p class="text-muted">
                        Member since: {{ user.created_at|date('F Y') }}
                    </p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Statistics</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Uploaded:</strong></td>
                            <td class="text-end">{{ uploaded_formatted }}</td>
                        </tr>
                        <tr>
                            <td><strong>Downloaded:</strong></td>
                            <td class="text-end">{{ downloaded_formatted }}</td>
                        </tr>
                        <tr>
                            <td><strong>Ratio:</strong></td>
                            <td class="text-end">
                                {% if ratio == '∞' %}
                                    <span class="badge bg-success">{{ ratio }}</span>
                                {% elseif ratio >= 1 %}
                                    <span class="badge bg-success">{{ ratio }}</span>
                                {% elseif ratio >= 0.5 %}
                                    <span class="badge bg-warning">{{ ratio }}</span>
                                {% else %}
                                    <span class="badge bg-danger">{{ ratio }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Torrents:</strong></td>
                            <td class="text-end">{{ torrent_count }}</td>
                        </tr>
                    </table>
                </div>
            </div>

            {% if user.location or user.website %}
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">About</h5>
                    </div>
                    <div class="card-body">
                        {% if user.location %}
                            <p><i class="bi bi-geo-alt"></i> {{ user.location }}</p>
                        {% endif %}
                        {% if user.website %}
                            <p><i class="bi bi-globe"></i> <a href="{{ user.website }}" target="_blank" rel="noopener">{{ user.website }}</a></p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Torrents</h5>
                </div>
                <div class="card-body">
                    {% if torrents|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="text-center">Size</th>
                                        <th class="text-center">Seeds</th>
                                        <th class="text-center">Leeches</th>
                                        <th>Uploaded</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for torrent in torrents %}
                                        <tr>
                                            <td>
                                                <a href="/torrent/{{ torrent.id }}">{{ torrent.name }}</a>
                                            </td>
                                            <td class="text-center">{{ torrent.size_formatted }}</td>
                                            <td class="text-center">
                                                <span class="badge bg-success">{{ torrent.seeders }}</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-warning">{{ torrent.leechers }}</span>
                                            </td>
                                            <td>
                                                <small>{{ torrent.created_at }}</small>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted">This user hasn't uploaded any torrents yet.</p>
                    {% endif %}
                </div>
            </div>

            {% if user.signature %}
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">Signature</h5>
                    </div>
                    <div class="card-body">
                        <p>{{ user.signature }}</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
