# Application Configuration
APP_NAME="Bittytorrent"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bittytorrent
DB_USERNAME=root
DB_PASSWORD=

# Security
SESSION_NAME=bittytorrent_session
SESSION_LIFETIME=7200
HASH_ALGO=argon2id

# Tracker Settings
TRACKER_OPEN=true
ANNOUNCE_INTERVAL=1800
MIN_INTERVAL=900
DEFAULT_PEERS=50
MAX_PEERS=50
FORCE_COMPACT=true
FULL_SCRAPE=false

# Upload Settings
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=torrent

# Logging
LOG_LEVEL=debug
LOG_FILE=var/logs/app.log
